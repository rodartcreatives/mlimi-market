rules_version = '2';

/* ============================================================
   MLIMI MARKET — FIRESTORE SECURITY RULES
   ------------------------------------------------------------
   These rules are the actual security boundary. Anything the
   frontend checks (role, ownership, admin status) is only for
   UI convenience — a user can open dev tools and call Firestore
   directly, bypassing every frontend check. These rules are
   what actually stops them.

   ADMIN ACCESS: hardcoded UID allowlist, not a Firestore field.
   Replace the UIDs below with real Firebase Auth UIDs before
   deploying. Do NOT create an `isAdmin` field on user documents
   that users can write to themselves — that would let anyone
   grant themselves admin by editing their own profile.
   ============================================================ */

function isAdmin() {
  return request.auth != null && request.auth.uid in [
    // "PASTE_YOUR_FIREBASE_UID_HERE"
  ];
}

function isSignedIn() {
  return request.auth != null;
}

function isOwner(userId) {
  return isSignedIn() && request.auth.uid == userId;
}

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- users ---------- */
    match /users/{userId} {
      allow read: if true; // profiles are public (seller name, district, verification badge)
      allow create: if isOwner(userId)
                    // a user cannot create their own profile already verified
                    && request.resource.data.isVerified == false;
      allow update: if (
                      isOwner(userId)
                      // isVerified can never be changed by the user themselves —
                      // only admin, via the Firebase console or a trusted backend
                      // process, can flip this. This is what makes "Verified
                      // Seller" trustworthy instead of a self-claimed label.
                      && request.resource.data.isVerified == resource.data.isVerified
                    )
                    // FIX: wrapped the owner branch in parens. && binds tighter
                    // than || in these rules too, so this was already correct,
                    // but leaving it unparenthesized made it read like admin
                    // could bypass the isVerified check — parens make the
                    // intended grouping explicit instead of relying on operator
                    // precedence a reader has to double-check.
                    || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    /* ---------- categories ---------- */
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- listings ---------- */
    match /listings/{listingId} {
      // Public can read approved+available listings; sellers can
      // read their own listings regardless of approval status.
      allow read: if resource.data.isApproved == true
                  || (isSignedIn() && resource.data.sellerId == request.auth.uid)
                  || isAdmin();

      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid
                    // sellers cannot publish already-approved listings —
                    // moderation queue must approve them
                    && request.resource.data.isApproved == false
                    // FIX: sellerVerified is denormalized onto the listing for
                    // display, but nothing previously stopped a client from
                    // writing sellerVerified: true directly, bypassing
                    // createListing()'s honest copy of the real profile value.
                    // This forces it to match the seller's actual users/{uid}
                    // doc — the same source of truth isVerified is protected
                    // from self-editing above.
                    && request.resource.data.sellerVerified ==
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified;

      allow update: if isAdmin()
                    || (
                      isSignedIn()
                      && resource.data.sellerId == request.auth.uid
                      // an owner can edit their own listing but cannot
                      // grant themselves approval
                      && request.resource.data.isApproved == resource.data.isApproved
                      // FIX: same guard as create — an owner editing their
                      // listing cannot claim a verified badge they don't
                      // actually have on their profile.
                      && request.resource.data.sellerVerified ==
                         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified
                    );

      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.sellerId == request.auth.uid);
    }

    /* ---------- favourites ---------- */
    match /favourites/{favId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /* ---------- reports ---------- */
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /* ---------- enquiries ---------- */
    match /enquiries/{enquiryId} {
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid
                    // FIX: previously sellerId was trusted as sent by the
                    // client, with no check it belonged to the named
                    // listing. Since users/{uid} is public-read, UIDs are
                    // discoverable — without this, anyone signed in could
                    // spoof an enquiry into a stranger's inbox by pairing
                    // any sellerId with any listingId. This forces sellerId
                    // to match the real owner of the listing being enquired
                    // about.
                    && request.resource.data.sellerId ==
                       get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId;
      allow read: if isAdmin()
                  || (isSignedIn() && (
                       resource.data.buyerId == request.auth.uid
                       || resource.data.sellerId == request.auth.uid
                     ));
      allow update, delete: if isAdmin();
    }

    /* ---------- wanted_requests (future — not built yet) ----------
       Modeled now so the collection name and field shape are
       agreed. Rules follow the same ownership pattern as listings
       once this ships: buyer owns their own request, public can
       read open ones, admin moderates.
    ------------------------------------------------------------ */
    match /wanted_requests/{requestId} {
      allow read, write: if false; // locked until this feature is built
    }
  }
}
